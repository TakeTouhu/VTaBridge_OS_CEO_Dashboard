# サーバー設定
PORT=3000
# SQLiteデータベースの保存先(省略時: ./data)
# DATA_DIR=/var/lib/vtabridge

# 初回起動時に作成される管理者アカウント。
# ADMIN_EMAIL と ADMIN_PASSWORD を両方設定すると、2回目以降の起動でも内容に同期される
ADMIN_EMAIL=ceo@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=社長

# AI機能(Phase 4 以降)。未設定の場合はルールベースで動作
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
